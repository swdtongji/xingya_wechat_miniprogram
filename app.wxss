/* app.wxss - 全局样式 */
page {
  background: #0f0f1e;
  color: #e4e4f0;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 28rpx;
}

.btn {
  padding: 20rpx 30rpx;
  background: #3b3b5c;
  color: #fff;
  border-radius: 12rpx;
  text-align: center;
  font-size: 30rpx;
  border: 1rpx solid #555577;
}
.btn-primary { background: #4a7cff; border-color: #4a7cff; }
.btn-danger  { background: #ff4a7c; border-color: #ff4a7c; }
.btn[disabled] { opacity: 0.4; }

.card {
  background: #1a1a2e;
  border: 1rpx solid #2a2a44;
  border-radius: 16rpx;
  padding: 24rpx;
  margin: 20rpx 0;
}

.muted { color: #888ab0; }
.success { color: #4ade80; }
.warn { color: #fbbf24; }
.error { color: #ff6b7a; }
